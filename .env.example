# LoyaltyLens Platform Environment Configuration Example

# Project Settings
PROJECT_NAME="LoyaltyLens Customer Retention Intelligence Platform"
VERSION="2.0.0"
ENV="development"
DEBUG=true

# Database Configuration (PostgreSQL in Production / Docker, SQLite for local quickstart)
# DATABASE_URL=postgresql://loyalty_user:loyalty_password@localhost:5432/loyaltylens_db
DATABASE_URL=sqlite:///./loyaltylens.db

# Authentication Security Secrets
JWT_SECRET=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini AI Integration Key (Optional - Fallback logic is used if absent)
GEMINI_API_KEY=

# Redis Cache & Background Queue
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
